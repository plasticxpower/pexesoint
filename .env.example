# API Keys for Animal Database
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Database Configuration
DATABASE_PATH=./wikipedia_animal_database.json
VERIFIED_IMAGES_DIR=./verified_images
TEMP_IMAGES_DIR=./temp_images

# Hugging Face Validation Settings
MIN_REAL_PHOTO_CONFIDENCE=0.8
MIN_ANIMAL_CONFIDENCE=0.7
MIN_QUALITY_SCORE=0.6
MAX_ILLUSTRATION_SCORE=0.3

# API Rate Limits (requests per minute)
WIKIPEDIA_RATE_LIMIT=60
HUGGINGFACE_RATE_LIMIT=30

# Image Processing
MAX_IMAGES_PER_ANIMAL=10
IMAGE_DOWNLOAD_TIMEOUT=10000
VALIDATION_DELAY=1000